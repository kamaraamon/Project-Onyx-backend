{
  "name": "onyx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @onyx/db exec prisma generate && vitest run",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "turbo": "2.11.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
